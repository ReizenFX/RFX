<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.reizenfx.rfx" ExtensionBundleVersion="1.0.0" ExtensionBundleName="RFX" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.reizenfx.rfx.panel" Version="1.0.0" />
